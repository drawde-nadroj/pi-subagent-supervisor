{
  "name": "pi-subagent-supervisor",
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "description": "Supervise isolated, configurable subagents for Pi",
  "author": {
    "name": "Jordan",
    "url": "https://github.com/drawde-nadroj"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawde-nadroj/pi-subagent-supervisor.git"
  },
  "homepage": "https://github.com/drawde-nadroj/pi-subagent-supervisor#readme",
  "bugs": {
    "url": "https://github.com/drawde-nadroj/pi-subagent-supervisor/issues"
  },
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "ai-agents"
  ],
  "files": [
    "*.ts",
    "!*.test.ts",
    "!routing-eval.ts",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test-concurrency=1 --test *.test.ts",
    "test:routing": "node --experimental-strip-types routing-eval.ts",
    "test:routing:fast": "node --experimental-strip-types routing-eval.ts --fast"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "typebox": "1.3.7"
  },
  "engines": {
    "node": ">=22.19"
  }
}
